// analysis: tau-fixed compatibility ideal over Q(i)
// Frozen Laderman free span; generated by two_sector_Qi_compat.py
ring r = (0,a),(x0,x1,x2,x3,x4,x5,x6,x7,x8),dp;
minpoly = a2+1;
ideal I =
  (1)*x0*x1,
  (1)*x0*x4,
  (1)*x0*x7,
  (1)*x0*x2,
  (1)*x0*x5,
  (1)*x0*x8,
  (1)*x0*x1,
  (-1)*x0^2+(1)*x1^2,
  (-1)*x0*x3+(a)*x1*x3+(1)*x1*x4,
  (-1)*x0*x6+(a)*x1*x6+(1)*x1*x7,
  (1)*x1*x2,
  (1)*x1*x5,
  (1)*x1*x8,
  (1)*x0*x2,
  (1)*x1*x2,
  (1)*x2*x4,
  (1)*x2*x7,
  (-1)*x0*x3+(a)*x2*x3+(1)*x2*x5,
  (-1)*x0*x6+(a)*x2*x6+(1)*x2*x8,
  (-1)*x1*x3+(1)*x3*x4,
  (1)*x3*x7,
  (1)*x3*x5,
  (-1)*x2*x3+(1)*x3*x8,
  (1)*x0*x4,
  (-1)*x1*x3+(1)*x3*x4,
  (1)*x4*x6,
  (-1)*x0*x3+(a)*x1*x3+(1)*x1*x4,
  ((2*a))*x1*x3+(-1)*x3^2+(1)*x4^2,
  (1)*x2*x4,
  (1)*x4*x5,
  (1)*x4*x8,
  (1)*x0*x5,
  (1)*x3*x5,
  (-1)*x2*x6+(1)*x5*x6,
  (1)*x1*x5,
  (1)*x4*x5,
  (1)*x5*x7,
  (-1)*x0*x3+(a)*x2*x3+(1)*x2*x5,
  (a)*x2*x3+(a)*x2*x6+(-1)*x3*x6+(1)*x5*x8,
  (1)*x4*x6,
  (-1)*x1*x6+(1)*x6*x7,
  (-1)*x2*x6+(1)*x5*x6,
  (1)*x6*x8,
  (1)*x0*x7,
  (1)*x3*x7,
  (-1)*x1*x6+(1)*x6*x7,
  (-1)*x0*x6+(a)*x1*x6+(1)*x1*x7,
  ((2*a))*x1*x6+(-1)*x6^2+(1)*x7^2,
  (1)*x2*x7,
  (1)*x5*x7,
  (1)*x7*x8,
  (1)*x0*x8,
  (-1)*x2*x3+(1)*x3*x8,
  (1)*x6*x8,
  (1)*x1*x8,
  (1)*x4*x8,
  (1)*x7*x8,
  (-1)*x0*x6+(a)*x2*x6+(1)*x2*x8,
  (a)*x2*x3+(a)*x2*x6+(-1)*x3*x6+(1)*x5*x8;
ideal J = std(I);
print("num_gens"); size(I);
print("affine_dim"); dim(J);
print("degree");
degree(J);
print("std_size"); size(J);
// Chart enumeration: manually set x_k=1
print("chart_x0");
ideal C0 = I, x0-1; ideal JC0 = std(C0); dim(JC0); degree(JC0); kill C0; kill JC0;
print("chart_x1");
ideal C1 = I, x1-1; ideal JC1 = std(C1); dim(JC1); degree(JC1); kill C1; kill JC1;
print("chart_x2");
ideal C2 = I, x2-1; ideal JC2 = std(C2); dim(JC2); degree(JC2); kill C2; kill JC2;
print("chart_x3");
ideal C3 = I, x3-1; ideal JC3 = std(C3); dim(JC3); degree(JC3); kill C3; kill JC3;
print("chart_x4");
ideal C4 = I, x4-1; ideal JC4 = std(C4); dim(JC4); degree(JC4); kill C4; kill JC4;
print("chart_x5");
ideal C5 = I, x5-1; ideal JC5 = std(C5); dim(JC5); degree(JC5); kill C5; kill JC5;
print("chart_x6");
ideal C6 = I, x6-1; ideal JC6 = std(C6); dim(JC6); degree(JC6); kill C6; kill JC6;
print("chart_x7");
ideal C7 = I, x7-1; ideal JC7 = std(C7); dim(JC7); degree(JC7); kill C7; kill JC7;
print("chart_x8");
ideal C8 = I, x8-1; ideal JC8 = std(C8); dim(JC8); degree(JC8); kill C8; kill JC8;
quit;
