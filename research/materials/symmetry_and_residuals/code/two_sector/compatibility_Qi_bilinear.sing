// analysis: general rank-one compatibility ideal over Q(i)
// Bilinear: N @ (v tensor w) = 0
ring r2 = (0,a),(v0,v1,v2,v3,v4,v5,v6,v7,v8,w0,w1,w2,w3,w4,w5,w6,w7,w8),dp;
minpoly = a2+1;
ideal I2 =
  (1)*v0*w3,
  (1)*v0*w4,
  (1)*v0*w5,
  (1)*v0*w6,
  (1)*v0*w7,
  (1)*v0*w8,
  (1)*v1*w0,
  (-1)*v0*w0+(1)*v1*w3,
  (-1)*v0*w1+(a)*v1*w1+(1)*v1*w4,
  (-1)*v0*w2+(a)*v1*w2+(1)*v1*w5,
  (1)*v1*w6,
  (1)*v1*w7,
  (1)*v1*w8,
  (1)*v2*w0,
  (1)*v2*w3,
  (1)*v2*w4,
  (1)*v2*w5,
  (-1)*v0*w1+(a)*v2*w1+(1)*v2*w7,
  (-1)*v0*w2+(a)*v2*w2+(1)*v2*w8,
  (-1)*v3*w3+(1)*v3*w4,
  (1)*v3*w5,
  (1)*v3*w7,
  (-1)*v3*w6+(1)*v3*w8,
  (1)*v4*w0,
  (-1)*v1*w1+(1)*v4*w1,
  (1)*v4*w2,
  (-1)*v3*w0+(a)*v3*w3+(1)*v4*w3,
  (a)*v1*w1+(-1)*v3*w1+(a)*v3*w3+(1)*v4*w4,
  (1)*v4*w6,
  (1)*v4*w7,
  (1)*v4*w8,
  (1)*v5*w0,
  (1)*v5*w1,
  (-1)*v2*w2+(1)*v5*w2,
  (1)*v5*w3,
  (1)*v5*w4,
  (1)*v5*w5,
  (-1)*v3*w0+(a)*v3*w6+(1)*v5*w6,
  (a)*v2*w2+(-1)*v3*w2+(a)*v3*w6+(1)*v5*w8,
  (1)*v6*w4,
  (-1)*v6*w3+(1)*v6*w5,
  (-1)*v6*w6+(1)*v6*w7,
  (1)*v6*w8,
  (1)*v7*w0,
  (1)*v7*w1,
  (-1)*v1*w2+(1)*v7*w2,
  (-1)*v6*w0+(a)*v6*w3+(1)*v7*w3,
  (a)*v1*w2+(-1)*v6*w2+(a)*v6*w3+(1)*v7*w5,
  (1)*v7*w6,
  (1)*v7*w7,
  (1)*v7*w8,
  (1)*v8*w0,
  (-1)*v2*w1+(1)*v8*w1,
  (1)*v8*w2,
  (1)*v8*w3,
  (1)*v8*w4,
  (1)*v8*w5,
  (-1)*v6*w0+(a)*v6*w6+(1)*v8*w6,
  (a)*v2*w1+(-1)*v6*w1+(a)*v6*w6+(1)*v8*w7;
ideal J2 = std(I2);
print("bilinear_num_gens"); size(I2);
print("bilinear_affine_dim"); dim(J2);
print("bilinear_degree");
degree(J2);
quit;
