// analysis generated Singular chart
// family=klein_diag prime=5 pivot=(2, 5, 6)
LIB "general.lib";
option(redSB);
ring r=5,(x0,x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14),lp;
ideal I=
x2*x7 + 4*x1*x8,
4 + x2*x9 + 4*x0*x11,
4 + x1*x12 + 4*x0*x13,
4 + x5*x7 + 4*x4*x8,
4 + x5*x9 + 4*x3*x11,
x4*x12 + 4*x3*x13,
x10,
4*x11*x13 + x10*x14,
x14,
4*x7*x9 + x6*x10,
1 + 4*x8*x10*x12 + x8*x9*x13 + x7*x11*x12 + 4*x7*x9*x14 + 4*x6*x11*x13 + x6*x10*x14,
x6,
4*x8*x12 + x6*x14;

ideal Fq = x0^5-x0,x1^5-x1,x2^5-x2,x3^5-x3,x4^5-x4,x5^5-x5,x6^5-x6,x7^5-x7,x8^5-x8,x9^5-x9,x10^5-x10,x11^5-x11,x12^5-x12,x13^5-x13,x14^5-x14;
I = I,Fq;

print("family=klein_diag prime=5 pivot=(2, 5, 6) equations=13 field_equations=True order=lp");
print("computing std");
ideal G=std(I);
print("std_done");
print("dim");
dim(G);
print("vdim");
vdim(G);
print("degree");
degree(G);
print("ncols_std");
size(G);
print("indep");
indepSet(G);
print("G");
G;
quit;
