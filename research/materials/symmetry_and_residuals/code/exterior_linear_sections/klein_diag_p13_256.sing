// analysis generated Singular chart
// family=klein_diag prime=13 pivot=(2, 5, 6)
LIB "general.lib";
option(redSB);
ring r=13,(x0,x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14),dp;
ideal I=
x2*x7 + 12*x1*x8,
12 + x2*x9 + 12*x0*x11,
12 + x1*x12 + 12*x0*x13,
12 + x5*x7 + 12*x4*x8,
12 + x5*x9 + 12*x3*x11,
x4*x12 + 12*x3*x13,
x10,
12*x11*x13 + x10*x14,
x14,
12*x7*x9 + x6*x10,
1 + 12*x8*x10*x12 + x8*x9*x13 + x7*x11*x12 + 12*x7*x9*x14 + 12*x6*x11*x13 + x6*x10*x14,
x6,
12*x8*x12 + x6*x14;
print("family=klein_diag prime=13 pivot=(2, 5, 6) equations=13");
print("computing std");
ideal G=std(I);
print("std_done");
print("dim");
dim(G);
print("degree");
degree(G);
print("ncols_std");
size(G);
print("lead_first20");
for (int i=1; i<=size(G) and i<=20; i=i+1) { lead(G[i]); }
quit;
