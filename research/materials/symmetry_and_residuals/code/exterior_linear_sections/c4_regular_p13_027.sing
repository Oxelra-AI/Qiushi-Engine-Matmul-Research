// analysis generated Singular chart
// family=c4_regular prime=13 pivot=(0, 2, 7)
LIB "general.lib";
option(redSB);
ring r=13,(x0,x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14),dp;
ideal I=
10*x14,
11 + 3*x5*x13 + 10*x4*x14,
1 + 10*x4,
8 + 3*x8*x10 + 10*x7*x11,
1 + 3*x2*x12 + 10*x0*x14,
3 + 10*x0,
11 + 3*x2*x4*x12 + 10*x2*x3*x13 + 10*x1*x5*x12 + 3*x1*x3*x14 + 3*x0*x5*x13 + 10*x0*x4*x14,
3*x1*x3 + 10*x0*x4,
8 + 3*x2*x7*x9 + 10*x2*x6*x10 + 10*x1*x8*x9 + 3*x1*x6*x11 + 3*x0*x8*x10 + 10*x0*x7*x11,
11 + 10*x5*x6 + 3*x3*x8,
10 + 10*x5*x9 + 3*x3*x11,
10 + 3*x7*x12 + 10*x6*x13,
11 + 3*x10*x12 + 10*x9*x13;
print("family=c4_regular prime=13 pivot=(0, 2, 7) equations=13");
print("computing std");
ideal G=std(I);
print("std_done");
print("dim");
dim(G);
print("degree");
degree(G);
print("ncols_std");
size(G);
print("lead_first20");
for (int i=1; i<=size(G) and i<=20; i=i+1) { lead(G[i]); }
quit;
