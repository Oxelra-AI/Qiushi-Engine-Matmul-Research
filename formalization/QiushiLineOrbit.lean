/-!
# Exhaustive nonzero-line orbit reduction over `Mat_3(F_2)`

The three literal vectors below are generated by `gen_line_orbit.py`.  For
each of the 511 nonzero row-major matrix codes, they give two invertible
matrices and one of the rank-1/rank-2/rank-3 representatives 1, 17, 273.
All table properties used by the public theorem are rechecked by the Lean
kernel with `decide`.
-/

open Matrix BigOperators

attribute [local instance] Classical.propDecidable

noncomputable section

namespace QiushiMatmul

set_option maxRecDepth 100000

set_option maxHeartbeats 12000000 in
private theorem matrixCodeNat_lt_all : ∀ M : Mat3,
    (if M 0 0 = 1 then 1 else 0) +
    (if M 0 1 = 1 then 2 else 0) +
    (if M 0 2 = 1 then 4 else 0) +
    (if M 1 0 = 1 then 8 else 0) +
    (if M 1 1 = 1 then 16 else 0) +
    (if M 1 2 = 1 then 32 else 0) +
    (if M 2 0 = 1 then 64 else 0) +
    (if M 2 1 = 1 then 128 else 0) +
    (if M 2 2 = 1 then 256 else 0) < 512 := by decide

/-- The row-major code inverse to `codeMat`. -/
def matrixCodeNat (M : Mat3) : Nat :=
    (if M 0 0 = 1 then 1 else 0) +
    (if M 0 1 = 1 then 2 else 0) +
    (if M 0 2 = 1 then 4 else 0) +
    (if M 1 0 = 1 then 8 else 0) +
    (if M 1 1 = 1 then 16 else 0) +
    (if M 1 2 = 1 then 32 else 0) +
    (if M 2 0 = 1 then 64 else 0) +
    (if M 2 1 = 1 then 128 else 0) +
    (if M 2 2 = 1 then 256 else 0)

/-- A matrix code bundled with its `0 ≤ code < 512` range proof. -/
def matrixCode (M : Mat3) : Fin 512 :=
  ⟨matrixCodeNat M, matrixCodeNat_lt_all M⟩

set_option maxHeartbeats 12000000 in
private theorem codeMat_matrixCode_all : ∀ M : Mat3,
    codeMat (matrixCodeNat M) = M := by decide

lemma codeMat_matrixCode (M : Mat3) : codeMat (matrixCodeNat M) = M :=
  codeMat_matrixCode_all M

