private def lineOrbitPCode (c : Fin 512) : Nat := lineOrbitPCodeTable[c]
private def lineOrbitQCode (c : Fin 512) : Nat := lineOrbitQCodeTable[c]
private def lineOrbitQTInvCode (c : Fin 512) : Nat := lineOrbitQTInvCodeTable[c]

set_option maxHeartbeats 12000000 in
private theorem lineOrbitRank_lt_all : ∀ c : Fin 512,
    lineOrbitRankTable[c] < 3 := by decide

def lineOrbitRank (c : Fin 512) : Fin 3 :=
  ⟨lineOrbitRankTable[c], lineOrbitRank_lt_all c⟩

def lineRepresentativeCode (k : Fin 3) : Nat :=
  match k.val with
  | 0 => 1
  | 1 => 17
  | _ => 273

def lineOrbitP (c : Fin 512) : Mat3 := codeMat (lineOrbitPCode c)
private def lineOrbitQ (c : Fin 512) : Mat3 := codeMat (lineOrbitQCode c)
def lineOrbitQTInv (c : Fin 512) : Mat3 := codeMat (lineOrbitQTInvCode c)

set_option maxHeartbeats 12000000 in
theorem lineOrbitP_det_ne_zero_all : ∀ c : Fin 512,
    (lineOrbitP c).det ≠ 0 := by decide

set_option maxHeartbeats 12000000 in
theorem lineOrbitQ_det_ne_zero_all : ∀ c : Fin 512,
    (lineOrbitQ c).det ≠ 0 := by decide

private lemma lineOrbitP_isUnitDet (c : Fin 512) : IsUnit (lineOrbitP c).det :=
  isUnit_iff_ne_zero.mpr (lineOrbitP_det_ne_zero_all c)

private lemma lineOrbitQ_isUnitDet (c : Fin 512) : IsUnit (lineOrbitQ c).det :=
  isUnit_iff_ne_zero.mpr (lineOrbitQ_det_ne_zero_all c)

set_option maxHeartbeats 12000000 in
theorem lineOrbitQTInv_right_inverse_all : ∀ c : Fin 512,
    (lineOrbitQ c).transpose * lineOrbitQTInv c = 1 := by decide

private lemma lineOrbitQTInv_eq (c : Fin 512) [Invertible (lineOrbitQ c)] :
    (lineOrbitQ c).transpose⁻¹ = lineOrbitQTInv c := by
  apply Matrix.inv_eq_right_inv
  exact lineOrbitQTInv_right_inverse_all c

set_option maxHeartbeats 12000000 in
theorem lineOrbit_action_explicit_all : ∀ c : Fin 512, c.val ≠ 0 →
    (lineOrbitP c).transpose *
      codeMat (lineRepresentativeCode (lineOrbitRank c)) * lineOrbitQTInv c =
        codeMat c.val := by decide

private lemma lineOrbit_action (c : Fin 512) [Invertible (lineOrbitQ c)]
    (hc : c.val ≠ 0) :
    actionA (lineOrbitP c) (lineOrbitQ c)
      (codeMat (lineRepresentativeCode (lineOrbitRank c))) = codeMat c.val := by
  rw [actionA, lineOrbitQTInv_eq]
  exact lineOrbit_action_explicit_all c hc

private lemma spanCodes_singleton (n : Nat) :
    spanCodes [n] = Submodule.span F2 {codeMat n} := by
  unfold spanCodes
  congr 1
  ext M
  simp

private lemma actionW_span_singleton (P Q M : Mat3) :
    actionW P Q (Submodule.span F2 {M}) =
      Submodule.span F2 {actionA P Q M} := by
  simp [actionW, Submodule.map_span, actionALinearMap]

private lemma representative_line_lb19 (P : FinitePremises) (k : Fin 3) :
    QuotientRankAtLeast
      (Submodule.span F2 {codeMat (lineRepresentativeCode k)}) 19 := by
  fin_cases k
  · simpa [lineRepresentativeCode, lineRank1, spanCodes_singleton] using P.line_rank1_lb19
  · simpa [lineRepresentativeCode, lineRank2, spanCodes_singleton] using P.line_rank2_lb19
  · simpa [lineRepresentativeCode, lineRank3, spanCodes_singleton] using P.line_rank3_lb19

/-- Every nonzero A-slot line is in the `GL_3(F_2) × GL_3(F_2)` orbit of
one of the three line representatives covered by `FinitePremises`. -/
theorem nonzero_line_lb19 (P : FinitePremises) (M : Mat3) (hM : M ≠ 0) :
    QuotientRankAtLeast (Submodule.span F2 {M}) 19 := by
  let c := matrixCode M
  have hcNat : matrixCodeNat M ≠ 0 := by
    intro hc
    apply hM
    exact (codeMat_matrixCode M).symm.trans (by rw [hc]; decide)
  have hc : c.val ≠ 0 := by simpa [c, matrixCode] using hcNat
  letI : Invertible (lineOrbitP c) :=
    Matrix.invertibleOfIsUnitDet _ (lineOrbitP_isUnitDet c)
  letI : Invertible (lineOrbitQ c) :=
    Matrix.invertibleOfIsUnitDet _ (lineOrbitQ_isUnitDet c)
  have hbase := representative_line_lb19 P (lineOrbitRank c)
  have htransport := quotientRankAtLeast_action
    (P := lineOrbitP c) (Q := lineOrbitQ c) hbase
  have hspan :
      actionW (lineOrbitP c) (lineOrbitQ c)
          (Submodule.span F2 {codeMat (lineRepresentativeCode (lineOrbitRank c))}) =
        Submodule.span F2 {M} := by
    rw [actionW_span_singleton, lineOrbit_action c hc]
    change Submodule.span F2 {codeMat (matrixCodeNat M)} = Submodule.span F2 {M}
    rw [codeMat_matrixCode]
  rwa [hspan] at htransport

