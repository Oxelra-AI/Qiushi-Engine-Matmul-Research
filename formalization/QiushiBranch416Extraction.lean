private theorem contain416_of_sec
    (U : Submodule F2 Mat3) (hWU : o416W ≤ U)
    (M : Mat3) (j : Fin 63) (hlabel : label416 M = Fin.succ j)
    (hsec : codeMat (sectionCode416 (Fin.succ j)) ∈ U) : M ∈ U := by
  have hrec := reconstruction416_mem M
  rw [hlabel] at hrec; have hrecU := hWU hrec
  have : M + codeMat (sectionCode416 (Fin.succ j)) +
      codeMat (sectionCode416 (Fin.succ j)) = M := by
    rw [add_assoc, mat3_add_self_eq_zero, add_zero]
  rw [← this]; exact U.add_mem hrecU hsec

private theorem o416_total {r : ℕ} (hr : r ≤ 16)
    (D : QuotientTensorDecomp o416W r) :
    (16 : Int) ≤ ∑ j : Fin 63, occVectorIntPadded
      (fun t : Fin r => label416 (D.A t)) 16 ⟨0, by decide⟩ j := by
  have htot := occVectorIntPadded_total (fun t : Fin r => label416 (D.A t)) ⟨0, by decide⟩ hr
  rw [htot]
  norm_num

