import QiushiPlaneOrbitGL

/-! Orbit equivalence uses all invertible matrices, not just selected invariants. -/
open Matrix
namespace QiushiMatmul.PlaneOrbit
noncomputable section

def ActionStep (W V : Space) : Prop :=
  (∃ P Q : Mat3, IsUnit P.det ∧ IsUnit Q.det ∧ actionW P Q W = V) ∨
    transposeW W = V

/-- Equivalence generated by the full GL3(F2) x GL3(F2) action and transpose. -/
def Equivalent : Space → Space → Prop := Relation.EqvGen ActionStep

theorem equivalent_refl (W : Space) : Equivalent W W := .refl W

theorem equivalent_symm {W V : Space} (h : Equivalent W V) : Equivalent V W := .symm _ _ h

theorem equivalent_trans {U V W : Space} (h : Equivalent U V) (h' : Equivalent V W) :
    Equivalent U W := .trans _ _ _ h h'

theorem action_equivalent (W : Space) (P Q : Mat3) (hP : IsUnit P.det)
    (hQ : IsUnit Q.det) : Equivalent W (actionW P Q W) :=
  .rel _ _ (Or.inl ⟨P, Q, hP, hQ, rfl⟩)

theorem transpose_equivalent (W : Space) : Equivalent W (transposeW W) :=
  .rel _ _ (Or.inr rfl)

theorem leftW_eq_actionW (L : Mat3) (W : Space) :
    leftW L W = actionW L.transpose 1 W := by
  unfold leftW actionW
  congr 1
  ext M i j
  simp [leftMap, actionALinearMap, actionA]

theorem generator_equivalent (g : Fin 4) (W : Space) : Equivalent W (genW g W) := by
  unfold genW genMap
  split
  · exact transpose_equivalent W
  · rw [← leftW, leftW_eq_actionW]
    apply action_equivalent
    · simpa using isUnit_iff_ne_zero.mpr (rowMatrix_det _)
    · simp

theorem transpose_closed {S : Set Space} (hS : GeneratorClosed S)
    (W : Space) (hW : W ∈ S) : transposeW W ∈ S := by
  exact hS 3 W hW

theorem left_closed {S : Set Space} (hS : GeneratorClosed S)
    (L : Mat3) (hL : IsUnit L.det) (W : Space) (hW : W ∈ S) : leftW L W ∈ S := by
  obtain ⟨w, rfl⟩ := invertible_word L hL
  exact word_closed hS w W hW

theorem action_factor (P Q : Mat3) (W : Space) :
    actionW P Q W = leftW P.transpose
      (transposeW (leftW (Q.transpose⁻¹).transpose (transposeW W))) := by
  simp only [leftW, transposeW, actionW, ← Submodule.map_comp]
  congr 1
  ext M i j
  simp [leftMap, actionALinearMap, actionA, Matrix.transpose_mul, Matrix.mul_assoc]

/-- Finite row-word completeness is what extends generator closure to every GL action. -/
theorem action_closed {S : Set Space} (hS : GeneratorClosed S)
    (P Q : Mat3) (hP : IsUnit P.det) (hQ : IsUnit Q.det)
    (W : Space) (hW : W ∈ S) : actionW P Q W ∈ S := by
  letI : Invertible P := Matrix.invertibleOfIsUnitDet P hP
  letI : Invertible Q := Matrix.invertibleOfIsUnitDet Q hQ
  rw [action_factor]
  exact left_closed hS _ (Matrix.isUnit_det_of_invertible _) _
    (transpose_closed hS _ (left_closed hS _ (Matrix.isUnit_det_of_invertible _) _
      (transpose_closed hS _ hW)))

theorem step_mem_iff {S : Set Space} (hS : GeneratorClosed S) {W V : Space}
    (h : ActionStep W V) : W ∈ S ↔ V ∈ S := by
  rcases h with ⟨P, Q, hP, hQ, rfl⟩ | rfl
  · letI : Invertible P := Matrix.invertibleOfIsUnitDet P hP
    letI : Invertible Q := Matrix.invertibleOfIsUnitDet Q hQ
    constructor
    · exact action_closed hS P Q hP hQ W
    · intro hW
      have h := action_closed hS P⁻¹ Q⁻¹ (Matrix.isUnit_det_of_invertible _)
        (Matrix.isUnit_det_of_invertible _) _ hW
      rwa [actionW_inv_actionW] at h
  · constructor
    · exact transpose_closed hS W
    · intro hW
      simpa only [transposeW_transposeW] using transpose_closed hS _ hW

theorem equivalent_mem_iff {S : Set Space} (hS : GeneratorClosed S) {W V : Space}
    (h : Equivalent W V) : W ∈ S ↔ V ∈ S := by
  induction h with
  | rel W V h => exact step_mem_iff hS h
  | refl W => rfl
  | symm W V h ih => exact ih.symm
  | trans U V W h h' ih ih' => exact ih.trans ih'

end
end QiushiMatmul.PlaneOrbit
