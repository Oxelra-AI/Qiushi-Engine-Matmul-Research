def rankKey (bs : List Nat) : Nat :=
  let (c, r1, r2, r3) := rankSignature bs
  c + 513 * (r1 + 513 * (r2 + 513 * r3))

/-- A fixed refinement selector; no completeness property of this list is assumed. -/
def refinementKeys : List Nat :=
  [1579535, 1583647, 2634271, 3159583, 4743743, 271064591, 272381983, 272644639, 272907295, 273169951, 540812303, 541604383, 541867039, 542129695, 542392351, 542655007, 542917663, 545289791, 546340415, 811614751, 811877407, 812140063, 815037503, 815562815, 816088127, 816613439, 1081625119, 1081887775, 1083734591, 1084259903, 1084785215, 1085310527, 1351110175, 1354532927, 1355058239, 1355583551, 1623230015, 1623755327, 1624280639, 1624805951, 1893503039, 1894028351, 2163250751, 2169045631, 2440369279, 2709591679, 2710642303, 2979864703, 3248036479, 3249087103, 3518309503, 3787531903, 6497649407]

def refinedSignature (bs : List Nat) : Nat × Nat :=
  (rankKey bs, if rankKey bs ∈ refinementKeys then pointKey bs else 0)

theorem refinedSignature_eq_of_overlap (i j : Fin 496) (W : Submodule F2 Mat3)
    (hi : frozenWangTable.OrbitImage i W) (hj : frozenWangTable.OrbitImage j W) :
    refinedSignature (frozenWangBasis i) = refinedSignature (frozenWangBasis j) := by
  have hr : rankKey (frozenWangBasis i) = rankKey (frozenWangBasis j) :=
    congrArg (fun p : Nat × Nat × Nat × Nat =>
      let (c, r1, r2, r3) := p; c + 513 * (r1 + 513 * (r2 + 513 * r3)))
      (rankSignature_eq_of_overlap i j W hi hj)
  unfold refinedSignature
  rw [hr, pointKey_eq_of_overlap i j W hi hj]

