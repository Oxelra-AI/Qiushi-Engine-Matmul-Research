
import Mathlib
import QiushiOrbit486FullBridgeAlg
import QiushiCodeSpanBridgeCore

/-!
# Orbit 486 quotient-coordinate labels

This file anchors the variable labels used by the compiled orbit-486
occupation certificate to the original RREF quotient convention.  It is
a code-level finite bridge: variable index `p : Fin 127` means nonzero
quotient label `q=p.val+1`, and the section is obtained by `lift_q(q, [0,1,2,4,5,7,8])`.
The generated theorems check, in Lean, that the compiled bridge masks agree
with the source row masks under this exact labeling.
-/

set_option maxHeartbeats 8000000
set_option maxRecDepth 5000

open BigOperators Finset
namespace QiushiMatmul

def WBasis486RREF : List Nat := [68, 10]
def freeBits486 : List Nat := [0, 1, 2, 4, 5, 7, 8]
def sectionBasis486 : List Nat := [1, 2, 4, 16, 32, 128, 256]

/-- RREF reduction modulo W=span{68,10}: clear pivot bits 6 and 3. -/
def redCode486 (n : Nat) : Nat :=
  Nat.xor (Nat.xor (n &&& 511) (if Nat.testBit n 6 then 68 else 0))
    (if Nat.testBit n 3 then 10 else 0)

/-- Compress the free bits [0,1,2,4,5,7,8] of a reduced 9-bit code into a 7-bit quotient label. -/
def quotientLabel486 (n : Nat) : Nat :=
  (if Nat.testBit (redCode486 n) 0 then 1 else 0) +
  (if Nat.testBit (redCode486 n) 1 then 2 else 0) +
  (if Nat.testBit (redCode486 n) 2 then 4 else 0) +
  (if Nat.testBit (redCode486 n) 4 then 8 else 0) +
  (if Nat.testBit (redCode486 n) 5 then 16 else 0) +
  (if Nat.testBit (redCode486 n) 7 then 32 else 0) +
  (if Nat.testBit (redCode486 n) 8 then 64 else 0)

/-- Lift a 7-bit quotient label through the original section basis. -/
def qLabelToCode486 (q : Nat) : Nat :=
  (if Nat.testBit q 0 then 1 else 0) +
  (if Nat.testBit q 1 then 2 else 0) +
  (if Nat.testBit q 2 then 4 else 0) +
  (if Nat.testBit q 3 then 16 else 0) +
  (if Nat.testBit q 4 then 32 else 0) +
  (if Nat.testBit q 5 then 128 else 0) +
  (if Nat.testBit q 6 then 256 else 0)

/-- The certificate variable `p` denotes the nonzero quotient label `p.val+1`. -/
def sectionCode486 (p : Fin 127) : Nat := qLabelToCode486 (p.val + 1)

theorem freeBits486_value : freeBits486 = [0, 1, 2, 4, 5, 7, 8] := rfl
theorem sectionBasis486_value : sectionBasis486 = [1, 2, 4, 16, 32, 128, 256] := rfl
theorem redCode486_zero_68 : redCode486 68 = 0 := by decide
theorem redCode486_zero_10 : redCode486 10 = 0 := by decide
theorem redCode486_idempotent_512 (n : Fin 512) : redCode486 (redCode486 n.val) = redCode486 n.val := by
  decide +revert
theorem sectionCode486_red_fixed (p : Fin 127) : redCode486 (sectionCode486 p) = sectionCode486 p := by
  decide +revert
theorem sectionCode486_roundtrip_label (p : Fin 127) : quotientLabel486 (sectionCode486 p) = p.val + 1 := by
  decide +revert
theorem quotientLabel486_fiber_size (q : Fin 128) :
    ((List.range 512).filter (fun n => quotientLabel486 n = q.val)).length = 4 := by
  decide +revert
theorem sectionCode486_pairwise_distinct_modW (p q : Fin 127) (h : p ≠ q) :
    redCode486 (Nat.xor (sectionCode486 p) (sectionCode486 q)) ≠ 0 := by
  decide +revert

