  have h : ahSecSelBTable.toList.all (fun x => decide (x < 3)) = true := by decide
  intro k b
  exact of_decide_eq_true (List.all_eq_true.mp h _
    (Vector.mem_toList_iff.mpr (Vector.getElem_mem (ahPairIndex k b).isLt)))
def ahSecSelA (k : Fin 3) (b : Fin 512) : Fin 3 :=
  ⟨ahSecSelATable[ahPairIndex k b], ahSecSelA_lt_all k b⟩
def ahSecSelB (k : Fin 3) (b : Fin 512) : Fin 3 :=
  ⟨ahSecSelBTable[ahPairIndex k b], ahSecSelB_lt_all k b⟩

def ahPlaneCode1 (i : Fin 8) : Nat :=
  match i.val with
  | 0 => 19
  | 1 => 20
  | 2 => 68
  | 3 => 84
  | 4 => 96
  | 5 => 258
  | 6 => 275
  | _ => 163
def ahPlaneCode2 (i : Fin 8) : Nat :=
  match i.val with | 7 => 84 | _ => 10
def ahPlaneM1 (i : Fin 8) : Mat3 := codeMat (ahPlaneCode1 i)
def ahPlaneM2 (i : Fin 8) : Mat3 := codeMat (ahPlaneCode2 i)
def ahPlaneW (i : Fin 8) : Submodule F2 Mat3 :=
  Submodule.span F2 ({ahPlaneM1 i, ahPlaneM2 i} : Set Mat3)

def ahPick3 (X Y : Mat3) (i : Fin 3) : Mat3 :=
  match i.val with | 0 => X | 1 => Y | _ => X + Y

def ahSourcePick (i : Fin 8) (tr : Bool) (s : Fin 3) : Mat3 :=
  if tr then ahPick3 (ahPlaneM1 i).transpose (ahPlaneM2 i).transpose s
  else ahPick3 (ahPlaneM1 i) (ahPlaneM2 i) s

def ahSourceW (i : Fin 8) (tr : Bool) : Submodule F2 Mat3 :=
  if tr then transposeW (ahPlaneW i) else ahPlaneW i

def ahSecValid (k : Fin 3) (b : Fin 512) : Prop :=
  2 ≤ rankCode (ahLineRepCode k) ∧ 2 ≤ rankCode b.val ∧
    2 ≤ rankCode (Nat.xor (ahLineRepCode k) b.val)

instance ahSecValidDecidable (k : Fin 3) (b : Fin 512) :
    Decidable (ahSecValid k b) := by
  unfold ahSecValid
  infer_instance

end QiushiMatmul
