def ahSecP (k : Fin 3) (b : Fin 512) : Mat3 := codeMat ahSecPTable[ahPairIndex k b]
def ahSecQ (k : Fin 3) (b : Fin 512) : Mat3 := codeMat ahSecQTable[ahPairIndex k b]
def ahSecQTInv (k : Fin 3) (b : Fin 512) : Mat3 := codeMat ahSecQTInvTable[ahPairIndex k b]
def ahSecTranspose (k : Fin 3) (b : Fin 512) : Bool := ahSecTransposeTable[ahPairIndex k b]

theorem ahSecPlane_lt_all : ∀ k : Fin 3, ∀ b : Fin 512,
    ahSecPlaneTable[ahPairIndex k b] < 8 := by
  have h : ahSecPlaneTable.toList.all (fun x => decide (x < 8)) = true := by decide
  intro k b
  exact of_decide_eq_true (List.all_eq_true.mp h _
    (Vector.mem_toList_iff.mpr (Vector.getElem_mem (ahPairIndex k b).isLt)))
def ahSecPlane (k : Fin 3) (b : Fin 512) : Fin 8 :=
  ⟨ahSecPlaneTable[ahPairIndex k b], ahSecPlane_lt_all k b⟩

theorem ahSecSelA_lt_all : ∀ k : Fin 3, ∀ b : Fin 512,
    ahSecSelATable[ahPairIndex k b] < 3 := by
